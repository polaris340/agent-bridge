# ── 커넥터 ────────────────────────────────────────────────────────────
CONNECTOR=discord

# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=

# ── 어디서 쓸 수 있나 ─────────────────────────────────────────────────
# 범위가 안 정해진 라우트가 있으면 봇이 뜨지 않는다. 아무나 에이전트를 돌리게 두지 않는다.
# 🔴 서버 단위로 열더라도 ALLOWED_USER_IDS 는 채워 두는 게 좋다.

# 이 서버 안이면 어느 채널에서든 쓸 수 있다 (채널마다 세션이 따로 뜬다).
# 서버 id 는 봇을 띄우면 로그에 찍힌다.
ALLOWED_GUILD_IDS=

# 따로 라우트를 갖는 채널 (아래 AGENT / AGENT_CWD 로 도는 고정 세션).
# 채널 우클릭 > "채널 ID 복사" (개발자 모드 필요)
ALLOWED_CHANNEL_IDS=

# 부를 수 있는 사람. 비우면 위 범위의 모든 사람.
ALLOWED_USER_IDS=

# 봇을 멘션한 글에만 반응한다. DM 은 멘션할 수가 없어 이 설정과 무관하게 받는다.
REQUIRE_MENTION=true

# ── 무엇으로, 어디서 도나 ─────────────────────────────────────────────
# 채널마다 아예 다르게 두려면 routes.json 을 만든다 (routes.example.json 참고).
# 그 파일이 있으면 아래 라우트 설정은 무시된다.

# ALLOWED_CHANNEL_IDS 에 적은 채널이 쓸 에이전트와 폴더
# codex | claude | 그 밖의 아무 CLI 이름 (모르는 이름은 화면 idle 방식으로 붙는다)
AGENT=codex
AGENT_CWD=~/workspace/my-game
# 비우면 에이전트 기본값(codex / claude). PATH 에서 못 찾으면 실경로를 적는다.
# 옵션을 같이 적어도 된다: AGENT_COMMAND=codex --yolo
AGENT_COMMAND=
# 비우면 <에이전트>-<폴더> 로 자동 생성
TMUX_SESSION=

# 그 밖의 채널·스레드가 쓸 에이전트와 폴더
NEW_SESSION_AGENT=claude
NEW_SESSION_CWD=~/workspace
NEW_SESSION_COMMAND=

# ── 폴더 고르기 (!project) ────────────────────────────────────────────
# 이 루트들의 바로 아래 폴더를 이름만으로 고를 수 있다.
# 없는 이름을 부르면 첫 루트 아래에 만들고 git init 까지 한다.
PROJECT_ROOTS=~/workspace

# 루트 밖의 폴더를 하나씩 더 붙일 때 (이름=경로, 쉼표 구분)
PROJECTS=

# ── 응답 ──────────────────────────────────────────────────────────────
# 작업 도중 에이전트가 내놓는 설명도 채널로 흘려보낸다.
STREAM_PROGRESS=true

# claude 세션을 Remote Control 로도 연다 (claude.ai 에서 이 세션들이 보인다).
CLAUDE_REMOTE_CONTROL=false

# ── 타이밍 (기본값으로 충분하다) ──────────────────────────────────────
# 붙여넣기 후 Enter 까지 대기. 비우면 에이전트별 기본값.
ENTER_DELAY_MS=
# Enter 후 턴이 시작되기까지 기다리는 시간
TURN_START_TIMEOUT_MS=90000
# 한 턴의 최대 시간. 0 이면 제한 없음.
# 제한을 걸면 아직 일하는 에이전트를 실패로 만들 뿐이다.
TURN_TIMEOUT_MS=0
# 로그가 이만큼 조용하면 턴이 끝난 것으로 본다 (claude 등 idle 판정용)
IDLE_MS=4000

# 채널·스레드 세션이 이만큼 조용하면 tmux 를 내린다 (비우면 30분, 여기선 6시간).
# 내려도 대화는 남아서, 다시 부르면 이어서 띄운다.
THREAD_IDLE_MS=21600000
